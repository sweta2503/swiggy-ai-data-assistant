# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: cheaper/stronger models per job. Leave empty to use OPENAI_MODEL for everything.
OPENAI_MODEL_LOW=
OPENAI_MODEL_MEDIUM=
OPENAI_MODEL_HIGH=

# Docker / Postgres (dev defaults are fine locally; change them for anything shared)
POSTGRES_PORT=5433  # host port; 5433 avoids clashing with a Postgres you may already run on 5432
POSTGRES_ADMIN_USER=swiggy_admin
POSTGRES_ADMIN_PASSWORD=admin_dev_pw
ETL_PASSWORD=etl_dev_pw
ASSISTANT_PASSWORD=assistant_dev_pw
DATABASE_URL_ADMIN=postgresql://swiggy_admin:admin_dev_pw@localhost:5433/swiggy
DATABASE_URL_ETL=postgresql://etl_writer:etl_dev_pw@localhost:5433/swiggy
DATABASE_URL_ASSISTANT=postgresql://assistant_ro:assistant_dev_pw@localhost:5433/swiggy

# FastAPI
API_KEY=change-me

# Agent limits
MAX_HEAL_ATTEMPTS=3
QUERY_TIMEOUT_MS=8000
MAX_ROWS=500
MAX_PLAN_COST=100000

# Demo only: forces a wrong first SQL so the self-healing loop is visible. Keep false.
DEMO_FAULT_INJECTION=false

# Optional: USD per 1M tokens from the OpenAI pricing page. Leave empty to skip cost reporting.
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=
